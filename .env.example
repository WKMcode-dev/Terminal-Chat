# Backend local (usado somente por `npm run dev:local`)
HOST=127.0.0.1
PORT=3000
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Opcional: quando ausente, usa .terminal-chat/data.json
# DATABASE_URL=postgres://terminal_chat:terminal_chat@127.0.0.1:5432/terminal_chat

# Clientes: o servidor oficial abaixo já é o padrão interno dos aplicativos.
# Este arquivo só precisa ser copiado para `.env` quando quiser sobrescrevê-lo.
VITE_API_URL=https://terminal-chat-6pet.onrender.com
TERMINAL_CHAT_SERVER=wss://terminal-chat-6pet.onrender.com/ws

# Para desenvolvimento local, prefira `npm run dev:local` em vez de editar URLs.
# VITE_API_URL=http://127.0.0.1:3000
# TERMINAL_CHAT_SERVER=ws://127.0.0.1:3000/ws

# Produção de uma comunidade própria (exemplo Render + Neon)
# NODE_ENV=production
# HOST=0.0.0.0
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
# VITE_API_URL=https://seu-terminal-chat.onrender.com
# TERMINAL_CHAT_SERVER=wss://seu-terminal-chat.onrender.com/ws
